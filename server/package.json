{
  "name": "repolens-server",
  "version": "1.0.0",
  "description": "RepoLens backend - clone, analyze, and chat with GitHub repositories",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js"
  },
  "dependencies": {
    "@google/genai": "^0.3.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "simple-git": "^3.27.0"
  },
  "nodemonConfig": {
    "watch": ["src"],
    "ext": "js,mjs,cjs,json",
    "ignore": ["clones/**", "clones/*", "node_modules/**"]
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
